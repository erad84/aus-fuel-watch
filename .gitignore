# The seed workbook is a manual FuelRadar export. Only the derived cycle params
# in data/params.seed.json are committed; the underlying series is never
# redistributed.
*.xlsx
*.xls
*.csv
data/seed/raw/

# API credentials. Loaded locally with `node --env-file=.env`, and supplied in
# CI as repository secrets. Never commit these; .env.example carries the
# placeholder shape instead.
.env
.env.*
!.env.example

# Published data lives on the `data` branch, which CI checks out here. Local
# collector runs write here too, as scratch.
/docs/

node_modules/
build/
.lock-waf*
*.pbw
.DS_Store
Thumbs.db
