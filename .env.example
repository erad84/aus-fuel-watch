# Copy to .env and fill in. .env is gitignored; never commit real values.
# Load locally with:  node --env-file=.env data/collect.js
# In CI these come from repository secrets of the same name.

# NSW FuelCheck (covers NSW and ACT). Register at https://api.nsw.gov.au/Product/Index/22
FUELCHECK_API_KEY=
FUELCHECK_API_SECRET=

# Queensland Fuel Prices (FPPDirect). Sign up via https://www.fuelpricesqld.com.au/
# API docs: documents/FuelPricesQLDDirectAPI(OUT)v1.5.pdf
# Production: https://fppdirectapi-prod.fuelpricesqld.com.au
QLD_FUEL_TOKEN=

# South Australia SAFPIS (FPPDirect). Register as a Data Publisher at
# https://www.safuelpricinginformation.com.au/publishers.html
# Production API: https://fppdirectapi-prod.safuelpricinginformation.com.au
SA_FUEL_TOKEN=

# Victoria Servo Saver open data. Apply at https://service.vic.gov.au/
VIC_FUEL_API_KEY=

# Western Australia FuelWatch needs no credentials.
